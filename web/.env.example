# Copy to .env.local. The publishable key is read-only (events) and safe to ship.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sub-path when deploying to GitHub Pages, e.g. /freefood-web. Leave blank for local dev.
NEXT_PUBLIC_BASE_PATH=

# Optional: draw the map with Google instead of MapLibre/OpenFreeMap. Needs a key on
# a Google Cloud billing account (free up to the monthly credit, but not free-tier).
# The key ships in the page, so restrict it by HTTP referrer in the Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map style id; defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
