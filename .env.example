# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LLM extraction (gemini = free tier; anthropic = paid fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Apify (Instagram)
APIFY_TOKEN=
APIFY_POSTS_ACTOR=
APIFY_STORIES_ACTOR=

# Gmail API (OAuth desktop client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=FreeFood

# Forwarded event mail (pipeline/sources/forwarded.py). A dedicated mailbox students forward to;
# any IMAP host works. On Gmail this is an app password, which needs 2-Step Verification on.
# Leave blank and the source skips itself. See "Email Ingestion Plan.md".
FORWARD_IMAP_HOST=
FORWARD_IMAP_USER=
FORWARD_IMAP_PASSWORD=
FORWARD_IMAP_FOLDER=INBOX
FORWARD_ALLOWED_DOMAINS=berkeley.edu
