# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LLM extraction (gemini = free tier; anthropic = paid fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Apify (Instagram)
APIFY_TOKEN=
APIFY_POSTS_ACTOR=
APIFY_STORIES_ACTOR=

# Gmail API (OAuth desktop client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=FreeFood
